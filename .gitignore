# Everything in this repository is published on adnsaudio.com, so these must
# never be committed.

# Secrets and local settings. An .env.example with empty values is fine.
.env
.env.*
!.env.example

# Folder settings macOS's Finder writes into every folder it opens.
.DS_Store

# Tailwind's build tools (npm install); only the built assets/site.css is published.
node_modules/
# Written by scripts/page-classes.mjs on every build.
src/page-classes.txt
