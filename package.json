{
  "name": "adnsaudio-site",
  "private": true,
  "description": "Builds assets/site.css for adnsaudio.com from src/tailwind.css.",
  "scripts": {
    "build:css": "tailwindcss -i src/tailwind.css -o assets/site.css",
    "watch:css": "tailwindcss -i src/tailwind.css -o assets/site.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
